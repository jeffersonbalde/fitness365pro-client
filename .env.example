# Local development
VITE_LARAVEL_API=http://localhost:8000/api
# Public Laravel origin for OG/share pages (NOT the /api path)
VITE_PUBLIC_APP_URL=http://localhost:8000
VITE_FRONTEND_URL=http://localhost:5173

# Meta / Facebook Share Dialog (https://developers.facebook.com/apps/)
# App settings → Basic: App domains = localhost (hostname only, no http/port)
# Add platform → Website: http://localhost:5173/ and use http://localhost:8000 for share OG pages
# Facebook Login → Settings → Valid OAuth Redirect URIs: http://localhost:5173/ and http://localhost:8000/
VITE_FACEBOOK_APP_ID=

# Firebase client config (Firebase Console → Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# --- DigitalOcean production example ---
# IMPORTANT: VITE_* vars are baked in at BUILD time. In App Platform, set them on the
# client component with scope "Build time", then Force Rebuild and Deploy.
#
# VITE_LARAVEL_API=https://fitness365pro-wpwkq.ondigitalocean.app/fitness365pro-server/api
# VITE_PUBLIC_APP_URL=https://fitness365pro-wpwkq.ondigitalocean.app/fitness365pro-server
# VITE_FRONTEND_URL=https://fitness365pro-wpwkq.ondigitalocean.app
