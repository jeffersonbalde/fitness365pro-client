# Local development
VITE_LARAVEL_API=http://localhost:8000/api
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_FRONTEND_URL=http://localhost:5173

# Meta / Facebook Share Dialog
VITE_FACEBOOK_APP_ID=

# Firebase client config (Firebase Console → Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# --- DigitalOcean production example ---
# Set these in App Platform → client component → Environment (BUILD TIME vars).
# VITE_LARAVEL_API must point to your Laravel API app URL (with or without /api).
# Examples:
#   VITE_LARAVEL_API=https://fitness365pro-api-xxxxx.ondigitalocean.app
#   VITE_LARAVEL_API=https://fitness365pro-api-xxxxx.ondigitalocean.app/api
# VITE_PUBLIC_APP_URL=https://fitness365pro-wpwkq.ondigitalocean.app
# VITE_FRONTEND_URL=https://fitness365pro-wpwkq.ondigitalocean.app
